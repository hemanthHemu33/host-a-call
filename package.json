{
  "name": "host-a-call",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.11.0 <25",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:admin": "pnpm --filter @connecto/admin build",
    "build:api": "pnpm --filter @connecto/api build",
    "build:backend": "pnpm --filter @connecto/domain build && pnpm --filter @connecto/api-contracts build && pnpm --filter @connecto/backend-architecture build && pnpm --filter @connecto/backend-runtime build && pnpm --filter @connecto/api build && pnpm --filter @connecto/worker build",
    "build:mobile": "pnpm --filter @connecto/mobile build",
    "build:worker": "pnpm --filter @connecto/worker build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm spellcheck && pnpm build",
    "clean": "node scripts/clean.mjs",
    "contracts:check-diff": "pnpm --filter @connecto/api-contracts check-diff",
    "contracts:generate": "pnpm --filter @connecto/api-contracts generate && pnpm exec prettier --write docs/contracts/openapi-v1.json docs/contracts/openapi-v1.baseline.json docs/contracts/contract-manifest.json docs/contracts/v1-client.ts",
    "contracts:lint": "pnpm --filter @connecto/api-contracts lint:contracts",
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:admin": "pnpm --filter @connecto/admin dev",
    "dev:api": "pnpm --filter @connecto/api dev",
    "dev:backend": "pnpm -r --parallel --filter @connecto/api --filter @connecto/worker dev",
    "dev:mobile": "pnpm --filter @connecto/mobile dev",
    "dev:worker": "pnpm --filter @connecto/worker dev",
    "infra:backend:down": "docker compose -f docker-compose.backend.yml down",
    "infra:backend:up": "docker compose -f docker-compose.backend.yml up -d postgres redis azurite",
    "db:migrate": "pnpm --filter @connecto/backend-runtime migrate",
    "db:explain-plans": "pnpm --filter @connecto/backend-runtime explain:plans",
    "db:probe-constraints": "pnpm --filter @connecto/backend-runtime probe:constraints",
    "db:seed": "pnpm --filter @connecto/backend-runtime seed",
    "db:smoke:migrate-seed": "pnpm --filter @connecto/backend-runtime smoke:migrate-seed",
    "db:validate-migrations": "pnpm --filter @connecto/backend-runtime validate:migrations",
    "docker:backend:config": "docker compose -f docker-compose.backend.yml config",
    "prebuild:mobile": "pnpm --filter @connecto/mobile prebuild",
    "prebuild:mobile:android": "pnpm --filter @connecto/mobile prebuild:android",
    "prebuild:mobile:clean": "pnpm --filter @connecto/mobile prebuild:clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "prepare": "node scripts/setup-husky.mjs",
    "providers:smoke": "pnpm --filter @connecto/backend-runtime provider:smoke",
    "spellcheck": "cspell .",
    "test": "pnpm -r --if-present test",
    "test:backend-architecture": "pnpm --filter @connecto/backend-architecture test",
    "test:api-contracts": "pnpm --filter @connecto/api-contracts test",
    "test:backend-runtime": "pnpm --filter @connecto/backend-runtime test",
    "check:backend": "pnpm contracts:generate && pnpm contracts:lint && pnpm contracts:check-diff && pnpm db:validate-migrations && pnpm test:api-contracts && pnpm --filter @connecto/backend-architecture test && pnpm --filter @connecto/backend-runtime test && pnpm build:backend",
    "typecheck": "tsc -b --pretty false",
    "doctor:expo": "pnpm --filter @connecto/mobile exec expo-doctor"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@connecto/eslint-config": "workspace:*",
    "@connecto/tsconfig": "workspace:*",
    "cspell": "10.0.1",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "knip": "6.27.0",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3"
  }
}
