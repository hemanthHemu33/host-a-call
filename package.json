{
  "name": "host-a-call",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.11.0 <25",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build && npm --prefix apps/admin/samvad-admin run build && npm run build:backend",
    "build:admin": "npm --prefix apps/admin/samvad-admin run build",
    "build:api": "npm --prefix backend/samvad-api run build",
    "build:backend": "npm --prefix backend/samvad-api run build",
    "build:mobile": "pnpm --filter @connecto/mobile build",
    "build:worker": "npm --prefix backend/samvad-api run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm spellcheck && pnpm build && npm run check:backend",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:admin": "npm --prefix apps/admin/samvad-admin run dev",
    "dev:api": "npm --prefix backend/samvad-api run start:dev",
    "dev:backend": "npm --prefix backend/samvad-api run start:dev",
    "dev:mobile": "pnpm --filter @connecto/mobile dev",
    "dev:worker": "npm --prefix backend/samvad-api run worker:dev",
    "infra:backend:down": "docker compose -f backend/samvad-api/docker-compose.yml down",
    "infra:backend:up": "docker compose -f backend/samvad-api/docker-compose.yml up -d",
    "docker:backend:config": "docker compose -f backend/samvad-api/docker-compose.yml config",
    "prebuild:mobile": "pnpm --filter @connecto/mobile prebuild",
    "prebuild:mobile:android": "pnpm --filter @connecto/mobile prebuild:android",
    "prebuild:mobile:clean": "pnpm --filter @connecto/mobile prebuild:clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "prepare": "node scripts/setup-husky.mjs",
    "spellcheck": "cspell .",
    "test": "pnpm -r --if-present test && npm run test:backend",
    "test:backend": "npm --prefix backend/samvad-api test -- --runInBand",
    "check:backend": "npm run build:backend && npm run test:backend",
    "typecheck": "tsc -b --pretty false",
    "doctor:expo": "pnpm --filter @connecto/mobile exec expo-doctor"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@connecto/eslint-config": "workspace:*",
    "@connecto/tsconfig": "workspace:*",
    "cspell": "10.0.1",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "knip": "6.27.0",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3"
  }
}
