{
  "name": "@connecto/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform web",
    "clean": "node -e \"require('fs').rmSync('.expo',{force:true,recursive:true});require('fs').rmSync('dist',{force:true,recursive:true})\"",
    "dev": "expo start --dev-client --port 8081",
    "predev:android": "pnpm run prepare:android-paths",
    "dev:android": "expo run:android --port 8081",
    "dev:ios": "expo run:ios",
    "lint": "eslint .",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --clean",
    "prepare:android-paths": "node ./scripts/prepare-windows-expo-modules.mjs",
    "start": "expo start --dev-client --port 8081",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@connecto/design-tokens": "workspace:*",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/auth": "27.1.0",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/metro-runtime": "~57.0.6",
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rive-app/react-native": "0.4.18",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "5.101.2",
    "expo": "57.0.7",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.7",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.6",
