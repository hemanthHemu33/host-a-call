{
  "extends": "@connecto/tsconfig/expo.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app.config.ts",
    "babel.config.js",
    "metro.config.js",
    "tailwind.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "nativewind-env.d.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
