{
  "extends": "@connecto/tsconfig/expo.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app.config.ts",
    "babel.config.js",
    "metro.config.js",
    "vitest.config.ts",
    "vitest.setup.ts",
    "test/samvad/**/*.ts",
    "test/samvad/**/*.tsx",
    "src/samvad/**/*.ts",
    "src/samvad/**/*.tsx",
    "src/samvad-app/**/*.ts",
    "src/samvad-app/**/*.tsx",
    "src/features/auth/firebase-phone-auth.ts",
    "src/platform/secure-storage.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
