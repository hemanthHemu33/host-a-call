# development | preview | production
EXPO_PUBLIC_CONNECTO_ENV=development

# mock mode must be false in production.
EXPO_PUBLIC_CONNECTO_MOCK_MODE=true
EXPO_PUBLIC_CONNECTO_PROVIDER=mock

# Public frontend values only. Keep placeholders for local mock mode.
EXPO_PUBLIC_CONNECTO_API_BASE_URL=https://api.connecto.invalid
EXPO_PUBLIC_CONNECTO_AGORA_APP_ID=agora-app-id-placeholder
EXPO_PUBLIC_CONNECTO_RAZORPAY_KEY_ID=rzp_test_connecto_placeholder
EXPO_PUBLIC_CONNECTO_SENTRY_DSN=https://public@example.ingest.sentry.io/0
EXPO_PUBLIC_CONNECTO_DEEP_LINK_HOST=connecto.local
EXPO_PUBLIC_CONNECTO_ANDROID_UPDATE_URL=
EXPO_PUBLIC_CONNECTO_IOS_UPDATE_URL=

# Feature flags. Set false to gracefully disable heavy or external-provider paths.
EXPO_PUBLIC_CONNECTO_ENABLE_RIVE=true
EXPO_PUBLIC_CONNECTO_ENABLE_SKIA_HEAVY_VISUALS=true
EXPO_PUBLIC_CONNECTO_ENABLE_VIDEO_UPGRADE=true
EXPO_PUBLIC_CONNECTO_ENABLE_REFERRALS=true
EXPO_PUBLIC_CONNECTO_ENABLE_ANALYTICS=false

# Frontend-only onboarding simulation controls.
EXPO_PUBLIC_CONNECTO_ONBOARDING_PROVIDER=mock
EXPO_PUBLIC_CONNECTO_ONBOARDING_PROFILE_MODE=success
EXPO_PUBLIC_CONNECTO_ONBOARDING_LANGUAGE_MODE=success
EXPO_PUBLIC_CONNECTO_ONBOARDING_MEDIA_MODE=success
EXPO_PUBLIC_CONNECTO_ONBOARDING_PERMISSION_MODE=success
EXPO_PUBLIC_CONNECTO_ONBOARDING_NOTIFICATION_OUTCOME=granted

# Frontend-only pre-connect call simulation controls.
# Use staging/production here only when API_BASE_URL and AGORA_APP_ID point to real public frontend values.
EXPO_PUBLIC_CONNECTO_CALL_PROVIDER=mock
EXPO_PUBLIC_CONNECTO_CALL_ACTIVE_BACKEND=mock
EXPO_PUBLIC_CONNECTO_CALL_ACTIVE_MEDIA_BRIDGE=mock
EXPO_PUBLIC_CONNECTO_CALL_AUDIO_METERING=false
EXPO_PUBLIC_CONNECTO_CALL_CAMERA_PERMISSION=granted
EXPO_PUBLIC_CONNECTO_CALL_CAMERA_REQUEST_OUTCOME=granted
EXPO_PUBLIC_CONNECTO_CALL_MIC_PERMISSION=granted
EXPO_PUBLIC_CONNECTO_CALL_MIC_REQUEST_OUTCOME=granted
EXPO_PUBLIC_CONNECTO_CALL_RING_OUTCOME=accepted
EXPO_PUBLIC_CONNECTO_CALL_RING_DELAY_MS=900
EXPO_PUBLIC_CONNECTO_CALL_RING_TIMEOUT_MS=15000
EXPO_PUBLIC_CONNECTO_CALL_VIDEO_CONNECT_OUTCOME=connected
EXPO_PUBLIC_CONNECTO_CALL_VIDEO_CONNECT_DELAY_MS=1800
EXPO_PUBLIC_CONNECTO_CALL_VIDEO_COUNTDOWN_MS=3000
EXPO_PUBLIC_CONNECTO_CALL_VIDEO_REJECT_COOLDOWN_MS=30000
EXPO_PUBLIC_CONNECTO_CALL_VIDEO_REQUEST_OUTCOME=accepted
EXPO_PUBLIC_CONNECTO_CALL_VIDEO_REQUEST_DELAY_MS=2500
EXPO_PUBLIC_CONNECTO_CALL_VIDEO_REQUEST_TIMEOUT_MS=12000

# Frontend-only payment simulation controls.
EXPO_PUBLIC_CONNECTO_PAYMENT_PROVIDER=mock
