# development | preview | production
NEXT_PUBLIC_CONNECTO_ENV=development

# mock mode must be false in production.
NEXT_PUBLIC_CONNECTO_MOCK_MODE=true
NEXT_PUBLIC_CONNECTO_PROVIDER=mock

# Public frontend values only. Keep placeholders for local mock mode.
NEXT_PUBLIC_CONNECTO_API_BASE_URL=https://api.connecto.invalid
NEXT_PUBLIC_CONNECTO_SENTRY_DSN=https://public@example.ingest.sentry.io/0

# Feature flags. Set false to gracefully disable optional frontend flows.
NEXT_PUBLIC_CONNECTO_ENABLE_RIVE=true
NEXT_PUBLIC_CONNECTO_ENABLE_SKIA_HEAVY_VISUALS=true
NEXT_PUBLIC_CONNECTO_ENABLE_VIDEO_UPGRADE=true
NEXT_PUBLIC_CONNECTO_ENABLE_REFERRALS=true
NEXT_PUBLIC_CONNECTO_ENABLE_ANALYTICS=false
