{
  "name": "@connecto/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css-variables.css": "./src/css-variables.css"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@connecto/tsconfig": "workspace:*",
    "vitest": "4.1.10"
  }
}
